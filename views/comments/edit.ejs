<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Comment</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="page">
    <main class="container narrow">
        <a class="brand site-brand" href="/"><span class="brand-mark">t</span> threadline</a>
        <header class="page-header form-header">
            <div>
                <p class="eyebrow">Make it sound like you</p>
                <h1>Edit Comment</h1>
            </div>
            <a class="button secondary" href="/comments/<%= comment.id %>">Cancel</a>
        </header>

        <form class="comment-form" method="POST" action="/comments/<%= comment._id ? comment._id.toString() : comment.id %>?_method=PATCH">
            <label for="comment">Comment</label>
            <textarea id="comment" rows="8" name="comment" maxlength="2000" required><%= comment.comment %></textarea>
            <button class="button primary" type="submit">Save Changes</button>
        </form>
    </main>
</body>

</html>