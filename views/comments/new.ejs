<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Comment</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="page">
    <main class="container narrow">
        <header class="page-header form-header">
            <div>
                <p class="eyebrow">Create</p>
                <h1>New Comment</h1>
            </div>
            <a class="button secondary" href="/comments">Back</a>
        </header>

        <form class="comment-form" action="/comments" method="post">
            <label for="username">Username</label>
            <input type="text" id="username" placeholder="Enter your username" name="username" required>

            <label for="comment">Comment</label>
            <textarea id="comment" rows="5" name="comment" placeholder="Share your thoughts..." required></textarea>

            <button class="button primary" type="submit">Submit</button>
        </form>
    </main>
</body>

</html>