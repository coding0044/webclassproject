<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101827">
    <title>Choose a new password | Threadline</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-story" aria-label="Set a new password">
            <a class="brand" href="/comments"><span class="brand-mark">t</span> threadline</a>
            <div class="story-copy">
                <p class="auth-kicker">Verification complete</p>
                <h1>A secure<br>fresh start<br>is yours.</h1>
                <p class="story-description">Choose a new password to protect your account and get back to the conversations that matter.</p>
            </div>
            <div class="story-note"><span class="online-dot"></span> Your email code has been verified.</div>
            <span class="story-orb story-orb-one"></span>
            <span class="story-orb story-orb-two"></span>
        </section>

        <section class="auth-panel">
            <div class="auth-form-wrap">
                <a class="mobile-brand brand" href="/comments"><span class="brand-mark">t</span> threadline</a>
                <p class="eyebrow">Secure your account</p>
                <h2>Choose a new password</h2>
                <p class="auth-subtitle">Your email is verified. Set a new password with at least 8 characters.</p>
                <ol class="reset-steps" aria-label="Password reset steps">
                    <li class="complete"><span>✓</span>Email</li>
                    <li class="complete"><span>✓</span>Verify</li>
                    <li class="active"><span>3</span>New password</li>
                </ol>
                <% if (error) { %>
                    <div class="auth-error" role="alert"><%= error %></div>
                <% } %>

                <form class="auth-form" action="/reset-password" method="post">
                    <label for="password">New password</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="At least 8 characters" required>

                    <label for="confirmPassword">Confirm new password</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="Enter your password again" required>

                    <button class="auth-submit" type="submit">Update password <span aria-hidden="true">→</span></button>
                </form>

            </div>
            <p class="auth-footer">Thoughtful conversations start here.</p>
        </section>
    </main>
</body>

</html>
