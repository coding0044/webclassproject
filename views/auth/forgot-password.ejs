<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101827">
    <title>Forgot password | Threadline</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-story" aria-label="Password reset help">
            <a class="brand" href="/comments"><span class="brand-mark">t</span> threadline</a>
            <div class="story-copy">
                <p class="auth-kicker">A fresh start</p>
                <h1>Let’s get<br>you back<br>in the thread.</h1>
                <p class="story-description">Enter the email address linked to your account. We’ll send a short-lived code to help you reset your password securely.</p>
            </div>
            <div class="story-note"><span class="online-dot"></span> Your account stays yours.</div>
            <span class="story-orb story-orb-one"></span>
            <span class="story-orb story-orb-two"></span>
        </section>

        <section class="auth-panel">
            <div class="auth-form-wrap">
                <a class="mobile-brand brand" href="/comments"><span class="brand-mark">t</span> threadline</a>
                <p class="eyebrow">Account recovery</p>
                <h2>Forgot your password?</h2>
                <p class="auth-subtitle">We’ll email you a six-digit reset code that expires in 10 minutes.</p>
                <ol class="reset-steps" aria-label="Password reset steps">
                    <li class="active"><span>1</span>Email</li>
                    <li><span>2</span>Verify</li>
                    <li><span>3</span>New password</li>
                </ol>

                <% if (error) { %>
                    <div class="auth-error" role="alert"><%= error %></div>
                <% } %>

                <form class="auth-form" action="/forgot-password" method="post">
                    <label for="email">Email address</label>
                    <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" value="<%= email %>" maxlength="254" required>
                    <button class="auth-submit" type="submit">Send reset code <span aria-hidden="true">→</span></button>
                </form>

                <p class="auth-switch">Remembered your password? <a href="/login">Log in</a></p>
            </div>
            <p class="auth-footer">Thoughtful conversations start here.</p>
        </section>
    </main>
</body>

</html>
