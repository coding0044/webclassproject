<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101827">
    <title>Verify reset code | Threadline</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-story" aria-label="Verify your email">
            <a class="brand" href="/comments"><span class="brand-mark">t</span> threadline</a>
            <div class="story-copy">
                <p class="auth-kicker">A quick security check</p>
                <h1>Good conversations<br>are worth<br>protecting.</h1>
                <p class="story-description">Enter the one-time code we sent to your email. This helps make sure it’s really you.</p>
            </div>
            <div class="story-note"><span class="online-dot"></span> The code expires in 10 minutes.</div>
            <span class="story-orb story-orb-one"></span>
            <span class="story-orb story-orb-two"></span>
        </section>

        <section class="auth-panel">
            <div class="auth-form-wrap">
                <a class="mobile-brand brand" href="/comments"><span class="brand-mark">t</span> threadline</a>
                <p class="eyebrow">Step 2 of 3</p>
                <h2>Check your email</h2>
                <p class="auth-subtitle">Enter the six-digit code sent to <strong class="reset-email"><%= email %></strong>.</p>
                <ol class="reset-steps" aria-label="Password reset steps">
                    <li class="complete"><span>✓</span>Email</li>
                    <li class="active"><span>2</span>Verify</li>
                    <li><span>3</span>New password</li>
                </ol>

                <% if (message) { %>
                    <div class="auth-success" role="status"><%= message %></div>
                <% } %>
                <% if (error) { %>
                    <div class="auth-error" role="alert"><%= error %></div>
                <% } %>

                <form class="auth-form" action="/verify-reset-code" method="post">
                    <input type="hidden" name="email" value="<%= email %>">
                    <label for="code">Six-digit verification code</label>
                    <input class="otp-input" id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" aria-describedby="code-help" required>
                    <p class="field-help" id="code-help">The code expires after 10 minutes. You have up to five attempts.</p>
                    <button class="auth-submit" type="submit">Verify code <span aria-hidden="true">→</span></button>
                </form>

                <p class="auth-switch">Didn’t get a code? <a href="/forgot-password">Request another</a></p>
            </div>
            <p class="auth-footer">Thoughtful conversations start here.</p>
        </section>
    </main>
</body>

</html>
